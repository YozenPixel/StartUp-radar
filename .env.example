# ==============================================
# StartupRadar Environment Configuration Example
# Copy this file to .env before starting services
# ==============================================

# Backend Port (default 3001 to avoid conflict with Vite on 3000)
PORT=3001

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/startupradar?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# AI Engine (OpenAI API)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Redis (Caching & Message Queue)
REDIS_URL="redis://localhost:6379"

# Frontend URL (for Backend CORS)
FRONTEND_URL="http://localhost:3000"

# Frontend API URL (for Vite Client)
VITE_API_URL="http://localhost:3001"
