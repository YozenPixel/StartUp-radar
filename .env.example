# ==============================================
# StartupRadar Environment Configuration Example
# Copy this file to .env before starting services
# ==============================================

# Backend Port (default 3001 to avoid conflict with Vite on 3000)
PORT=3001

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/startupradar?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# ==============================================
# AI Engine Configuration (Multi-Provider Support)
# ==============================================
# Clé API universelle (OpenAI sk-..., Gemini AIza..., Groq gsk_..., OpenRouter sk-or-...)
AI_API_KEY="sk-proj-your-api-key"
# Rétro-compatibilité : OPENAI_API_KEY="sk-proj-your-api-key"

# Fournisseur IA : auto (détection auto par clé) | openai | gemini | groq | openrouter | deepseek | mistral | ollama | custom
AI_PROVIDER="auto"

# URL de base personnalisée (Optionnel : pour Ollama local, DeepSeek, LocalAI, vLLM, etc.)
# Exemples :
# - Ollama local : http://localhost:11434/v1
# - OpenRouter : https://openrouter.ai/api/v1
# - DeepSeek : https://api.deepseek.com/v1
# AI_BASE_URL="https://api.openai.com/v1"

# Modèle IA cible (Optionnel : utilise le modèle optimal par défaut du fournisseur)
# Exemples : gpt-4o-mini, gemini-2.5-flash, llama-3.3-70b-versatile, deepseek-chat, mistral-small-latest, llama3
# AI_MODEL="gpt-4o-mini"

# Redis (Caching & Message Queue)
REDIS_URL="redis://localhost:6379"

# Frontend URL (for Backend CORS)
FRONTEND_URL="http://localhost:3000"

# Frontend API URL (for Vite Client)
VITE_API_URL="http://localhost:3001"
